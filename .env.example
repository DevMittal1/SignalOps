# ─── LiveKit ────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Twilio ──────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Deepgram ────────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Agent Behaviour ─────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini
TTS_VOICE=alloy
AGENT_GREETING=Hi, I'm an AI revenue operations assistant. Does now work for a short pipeline visibility check?
MAX_CALL_MINUTES=30

# ─── Server ──────────────────────────────────────────────────────────────────
# Public URL where Twilio sends webhooks (use ngrok for local dev)
WEBHOOK_BASE_URL=https://your-domain.com
PORT=8080

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_DIR=./logs
LOG_LEVEL=INFO
JSON_LOGS=true

# ─── Cost Monitoring ─────────────────────────────────────────────────────────
COST_ALERT_THRESHOLD=5.0     # USD per session
DAILY_BUDGET_USD=100.0       # USD per day
