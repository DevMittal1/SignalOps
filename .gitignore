# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#1255, pipenv should generally not be tracked in a VCS.
#   However, if you are deploying an application, you want to ensure the same dependency versions are used,
#   so you should commit Pipfile.lock.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains locked versions.
#   You should commit poetry.lock to ensure consistent dependencies.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains locked versions.
#   You should commit pdm.lock to ensure consistent dependencies.
#pdm.lock

# PEP 582; cloudside packages for Python
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

